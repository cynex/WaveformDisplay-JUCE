# Normalise line endings for text files, let Git decide the diff/checkout
# behaviour per-platform, but keep source consistent as LF in the repo.
* text=auto eol=lf

# C++ source
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.inl  text eol=lf

# Build / project files
CMakeLists.txt text eol=lf
*.cmake         text eol=lf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Docs / config
*.md   text eol=lf
*.txt  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary assets - never touch line endings, and make sure git diff doesn't
# try to treat them as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.wav  binary
*.aiff binary
*.flac binary
*.mp3  binary
*.ogg  binary
*.exe  binary
*.dll  binary
*.lib  binary
*.pdb  binary
*.obj  binary
